{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rehearse.dev/schema/rehearse-project.v1.json",
  "title": "REHEARSE project export",
  "type": "object",
  "required": ["format", "version", "project"],
  "properties": {
    "format": { "const": "rehearse-project" },
    "version": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": { "$ref": "#/$defs/project" }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": ["id", "title", "materials", "moments", "dimensions", "risks", "injects", "decisions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
        "moments": { "type": "array", "items": { "$ref": "#/$defs/moment" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
        "injects": { "type": "array", "items": { "$ref": "#/$defs/inject" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "timingChecks": { "type": "array", "items": { "$ref": "#/$defs/timingCheck" } },
        "compileFindings": { "type": "array", "items": { "$ref": "#/$defs/compileFinding" } },
        "compileResolutions": { "type": "array", "items": { "type": "object" } },
        "simulations": { "type": "array", "items": { "$ref": "#/$defs/simulation" } },
        "reruns": { "type": "array", "items": { "$ref": "#/$defs/rerun" } },
        "generatedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "material": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "rows": { "type": "array" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "moment": {
      "type": "object",
      "required": ["id", "time", "title", "sourceName", "sourceRef"],
      "properties": {
        "id": { "type": "string" },
        "time": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "string" },
        "sourceName": { "type": "string" },
        "sourceRef": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dimension": {
      "type": "object",
      "required": ["id", "label", "cells"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "cells": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": ["id", "level", "category", "title", "evidence", "owner", "deadline", "rerun", "closed"],
      "properties": {
        "id": { "type": "string" },
        "level": { "enum": ["高", "中", "低"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "evidence": { "type": "string" },
        "owner": { "type": "string" },
        "deadline": { "type": "string" },
        "rerun": { "type": "string" },
        "closed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "inject": {
      "type": "object",
      "required": ["id", "title", "time", "choices"],
      "properties": {
        "id": { "type": "string" },
        "riskId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "choices": { "type": "array" }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["id", "injectId", "instruction", "owner", "notify", "rerun"],
      "properties": {
        "id": { "type": "string" },
        "injectId": { "type": "string" },
        "riskId": { "type": "string" },
        "instruction": { "type": "string" },
        "owner": { "type": "string" },
        "notify": { "type": "string" },
        "rerun": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "timingCheck": {
      "type": "object",
      "required": ["id", "momentId", "scriptName", "text"],
      "properties": {
        "id": { "type": "string" },
        "momentId": { "type": "string" },
        "scriptName": { "type": "string" },
        "text": { "type": "string" },
        "rate": { "type": "number", "minimum": 1 },
        "measuredSeconds": { "type": "number", "minimum": 0 },
        "measurementType": { "enum": ["", "media", "stopwatch"] },
        "measurementSource": { "type": "string" },
        "measurementHash": { "type": "string" },
        "measurementSegments": { "type": "array", "items": { "$ref": "#/$defs/measurementSegment" } },
        "measurementConfirmedFull": { "type": "boolean" },
        "measuredAt": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceType": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "measurementSegment": {
      "type": "object",
      "required": ["id", "label", "start", "end"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "compileFinding": {
      "type": "object",
      "required": ["id", "category", "momentTitle", "field", "title", "sources"],
      "properties": {
        "id": { "type": "string" },
        "category": { "const": "版本冲突" },
        "momentTitle": { "type": "string" },
        "field": { "type": "string" },
        "title": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["sourceId", "sourceName", "sourceRef", "value"],
            "properties": {
              "sourceId": { "type": "string" },
              "sourceName": { "type": "string" },
              "sourceRef": { "type": "string" },
              "value": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "rerun": {
      "type": "object",
      "required": ["id", "riskId", "performedBy", "verifiedBy", "note", "performedAt"],
      "properties": {
        "id": { "type": "string" },
        "riskId": { "type": "string" },
        "performedBy": { "type": "string", "minLength": 1 },
        "verifiedBy": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "performedAt": { "type": "string" },
        "evidenceName": { "type": "string" },
        "evidenceType": { "type": "string" },
        "evidenceSize": { "type": "number", "minimum": 0 },
        "evidenceHash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "simulation": {
      "type": "object",
      "required": ["id", "momentId", "title", "strategy", "delayMinutes", "timeline", "summary"],
      "properties": {
        "id": { "type": "string" },
        "riskId": { "type": "string" },
        "momentId": { "type": "string" },
        "title": { "type": "string" },
        "strategy": { "enum": ["cascade", "hold", "recover"] },
        "effectType": { "enum": ["start-delay", "duration-extension", "interruption"] },
        "effectLabel": { "type": "string" },
        "delayMinutes": { "type": "number", "minimum": 0 },
        "recoveryMinutes": { "type": "number", "minimum": 0 },
        "timeline": { "type": "array", "items": { "type": "object" } },
        "summary": { "type": "object" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
